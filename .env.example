# Public web platform
# Server-side only. Never expose this as NEXT_PUBLIC_*.
HERMES_CONTROL_PLANE_URL=https://your-secure-control-plane.example.com
HERMES_CONTROL_PLANE_TOKEN=replace-with-a-random-server-token

# Optional. If omitted, the free OpenStreetMap/Nominatim provider is used.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
